APP_ENV=development
APP_PORT=8080
LOG_LEVEL=debug

DATABASE_URL=postgres://inkspace:inkspace@localhost:5432/inkspace?sslmode=disable

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000


TRUSTED_PROXIES=

RATE_LIMIT_GLOBAL_RPS=40
RATE_LIMIT_GLOBAL_BURST=80
RATE_LIMIT_AUTH_RPS=0.5
RATE_LIMIT_AUTH_BURST=10
MAX_REQUEST_BODY_BYTES=1048576

LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_WINDOW=15m
RATE_LIMIT_OTP_RPS=0.0083
RATE_LIMIT_OTP_BURST=4

JWT_SECRET=replace-me-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

PHONE_CODE_TTL=10m

VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM_NAME=Inkspace

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Base64-encoded 32-byte key for encrypting stored OAuth tokens (Google Calendar).
# Generate with: openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=


STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=